{
  "name": "dsh-sensitive-guard",
  "version": "0.4.0",
  "description": "敏感保护：进入模型上下文前把密钥/令牌/密码替换为 <SG_> 占位符，明文加密存本地保管库；设置页与对话内提供小锁点击还原，工具可将明文导出为 0600 文件供命令执行时使用。",
  "license": "MIT",
  "author": "wangxinyu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangxy496/dsh-sensitive-guard.git"
  },
  "bugs": {
    "url": "https://github.com/wangxy496/dsh-sensitive-guard/issues"
  },
  "homepage": "https://github.com/wangxy496/dsh-sensitive-guard#readme",
  "keywords": ["dsh", "dsh-plugin", "sensitive", "mask", "vault", "secret", "redact"],
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "CHANGELOG.md", "LICENSE", "test.mjs"],
  "scripts": {
    "test": "node test.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
